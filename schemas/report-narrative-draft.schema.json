{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amdc.local/schemas/report-narrative-draft/1.0.0",
  "title": "Report narrative draft V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["suspected_cause"],
  "properties": {"suspected_cause": {"$ref": "#/$defs/suspectedCause"}},
  "$defs": {
    "suspectedCause": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F\\u0085\\u2028\\u2029])\\S(?:[\\s\\S]*\\S)?$"
    }
  }
}

