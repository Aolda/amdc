NODE_ENV=development

# Discord application/bot settings.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# AMDC runtime settings.
AMDC_ENVIRONMENT=dev
AMDC_DIAGNOSTIC_RUNNER=langchain
AMDC_AGENT_MODEL=
OPENAI_API_KEY=
# Set this when using LiteLLM or another OpenAI-compatible gateway.
OPENAI_BASE_URL=

# Server-owned Backend health endpoints used by backend_get_health.
AMDC_DEV_HEALTHCHECK_URL=https://example.com
AMDC_PROD_HEALTHCHECK_URL=https://example.com

# Server-owned Prometheus base URLs used by fixed read-only Prometheus tools.
AMDC_DEV_PROMETHEUS_URL=http://127.0.0.1:9090
AMDC_PROD_PROMETHEUS_URL=https://prometheus.example.com
# Direct user-MySQL diagnosis: dedicated read-only diagnostic account.
# Local host uses published port 33061; container-network mysql uses port 3306.
AMDC_DEV_MYSQL_HOST=
AMDC_DEV_MYSQL_PORT=33061
AMDC_DEV_MYSQL_USER=
AMDC_DEV_MYSQL_PASSWORD=
# Production requires a CA PEM string in TLS_CA.
AMDC_PROD_MYSQL_HOST=
AMDC_PROD_MYSQL_PORT=3306
AMDC_PROD_MYSQL_USER=
AMDC_PROD_MYSQL_PASSWORD=
AMDC_PROD_MYSQL_TLS_CA=
